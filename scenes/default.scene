# Default scene. Plain text, one entity per line, easy for agents to edit.
# Units are meters, Y is up, the camera looks down -Z at yaw 0.

sky    0.53 0.74 0.93
fog    90
ground size 120 tile 2 color_a 0.34 0.47 0.30 color_b 0.29 0.41 0.26
camera pos 0 1.7 8 yaw 0 pitch 0

# Landmarks to walk around: box pos <x y z> size <x y z> color <r g b>
# pos is the center of the box.
box pos 0 1 -6   size 2 2 2   color 0.85 0.30 0.25
box pos 6 1.5 -10 size 3 3 3   color 0.25 0.55 0.85
box pos -7 0.5 -4 size 4 1 2   color 0.90 0.80 0.30
box pos -12 3 -16 size 2 6 2   color 0.60 0.40 0.80
box pos 14 2 -2  size 1 4 8   color 0.75 0.75 0.75
box pos 0 0.25 -20 size 30 0.5 1 color 0.30 0.30 0.35
